{
  "functions": [
    {
      "source": "functions",
      "codebase": "default"
    }
  ],
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "database.rules.json",
      "README.md",
      "main.py",
      "functions/**",
      "**/.env*",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api",
        "function": {
          "functionId": "api",
          "region": "us-central1"
        }
      }
    ]
  }
}
